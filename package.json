{
  "name": "castle-crumble",
  "private": true,
  "version": "0.1.0",
  "description": "Castle Crumble x Castle Crashers 风格的物理崩塌网页游戏（单人 + 实时多人）",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=client",
    "dev:client": "npm run dev --workspace=client",
    "dev:server": "npm run dev --workspace=server",
    "build": "npm run build --workspace=client",
    "typecheck": "npm run typecheck --workspaces"
  },
  "dependencies": {
    "@socket.io/redis-adapter": "^8.3.0",
    "redis": "^4.7.0",
    "socket.io": "^4.8.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.3"
  },
  "type": "module"
}
